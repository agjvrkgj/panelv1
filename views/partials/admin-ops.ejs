<!-- 运维仪表盘 Tab -->
<div class="tab-panel space-y-4" data-tab="ops">

  <!-- 节点健康总览 -->
  <div class="glass rounded-2xl p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-white text-sm font-medium">📊 节点健康总览</h3>
      <button onclick="loadOpsDashboard()" class="text-[11px] px-3 py-1 rounded-full bg-white/5 text-gray-400 hover:bg-white/10 transition">🔄 刷新</button>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="ops-health-cards">
      <div class="rounded-xl bg-black/30 p-4 text-center border border-white/5">
        <div class="text-3xl font-bold text-white" id="ops-total">-</div>
        <div class="text-[11px] text-gray-500 mt-1">总节点</div>
      </div>
      <div class="rounded-xl bg-black/30 p-4 text-center border border-emerald-500/20">
        <div class="text-3xl font-bold text-emerald-400" id="ops-online">-</div>
        <div class="text-[11px] text-gray-500 mt-1">在线</div>
      </div>
      <div class="rounded-xl bg-black/30 p-4 text-center border border-yellow-500/20">
        <div class="text-3xl font-bold text-yellow-400" id="ops-offline">-</div>
        <div class="text-[11px] text-gray-500 mt-1">离线</div>
      </div>
      <div class="rounded-xl bg-black/30 p-4 text-center border border-red-500/20">
        <div class="text-3xl font-bold text-red-400" id="ops-blocked">-</div>
        <div class="text-[11px] text-gray-500 mt-1">疑似被墙</div>
      </div>
    </div>
  </div>

  <!-- 小乖巡检状态 -->
  <div class="glass rounded-2xl p-5">
    <h3 class="text-white text-sm font-medium mb-3">🐱 小乖巡检状态</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="rounded-xl bg-black/20 p-3 text-center">
        <div class="text-lg font-bold text-blue-400" id="ops-last-patrol">-</div>
        <div class="text-[10px] text-gray-500 mt-1">最近巡检</div>
      </div>
      <div class="rounded-xl bg-black/20 p-3 text-center">
        <div class="text-lg font-bold text-cyan-400" id="ops-patrol-count">0</div>
        <div class="text-[10px] text-gray-500 mt-1">今日巡检</div>
      </div>
      <div class="rounded-xl bg-black/20 p-3 text-center">
        <div class="text-lg font-bold text-orange-400" id="ops-swap-count">0</div>
        <div class="text-[10px] text-gray-500 mt-1">今日换IP</div>
      </div>
      <div class="rounded-xl bg-black/20 p-3 text-center">
        <div class="text-lg font-bold text-green-400" id="ops-fix-count">0</div>
        <div class="text-[10px] text-gray-500 mt-1">今日修复</div>
      </div>
    </div>
  </div>

  <!-- 运维事件 -->
  <div class="glass rounded-2xl p-5">
    <h3 class="text-white text-sm font-medium mb-3">🕐 运维事件</h3>
    <div id="ops-timeline" class="space-y-2 max-h-[400px] overflow-y-auto">
      <p class="text-gray-600 text-xs text-center py-4">加载中...</p>
    </div>
  </div>

  <!-- 运维配置 -->
  <div class="glass rounded-2xl p-5">
    <h3 class="text-white text-sm font-medium mb-4">⚙️ 运维配置</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="text-gray-500 text-xs block mb-1">目标节点数（0=不自动扩缩容）</label>
        <input type="number" id="ops-target-nodes" min="0" class="w-full bg-black/30 text-white px-3 py-2 rounded-xl border border-white/10 text-sm" value="0">
      </div>
      <div>
        <label class="text-gray-500 text-xs block mb-1">巡检间隔（分钟）</label>
        <input type="number" id="ops-patrol-interval" min="5" class="w-full bg-black/30 text-white px-3 py-2 rounded-xl border border-white/10 text-sm" value="30">
      </div>
      <div>
        <label class="text-gray-500 text-xs block mb-1">每日换 IP 上限</label>
        <input type="number" id="ops-max-daily-swaps" min="0" class="w-full bg-black/30 text-white px-3 py-2 rounded-xl border border-white/10 text-sm" value="10">
      </div>
      <div>
        <label class="text-gray-500 text-xs block mb-1">每日创建实例上限</label>
        <input type="number" id="ops-max-daily-creates" min="0" class="w-full bg-black/30 text-white px-3 py-2 rounded-xl border border-white/10 text-sm" value="3">
      </div>
    </div>

    <div class="mt-4 space-y-2">
      <label class="flex items-center justify-between p-3 rounded-xl bg-black/20 cursor-pointer hover:bg-white/5 transition">
        <div>
          <span class="text-white text-sm">🔄 被墙自动换 IP</span>
          <span class="text-emerald-400 text-[10px] ml-2">✅ 已生效</span>
          <span class="text-gray-600 text-xs ml-1">health.js 已实现</span>
        </div>
        <input type="checkbox" id="ops-auto-swap-ip" class="accent-rose-500">
      </label>
      <label class="flex items-center justify-between p-3 rounded-xl bg-black/20 cursor-pointer hover:bg-white/5 transition">
        <div>
          <span class="text-white text-sm">🔧 节点自动修复</span>
          <span class="text-emerald-400 text-[10px] ml-2 ops-active-badge" data-key="ops-auto-repair" style="display:none">✅ 已生效</span>
          <span class="text-gray-500 text-[10px] ml-2 ops-inactive-badge" data-key="ops-auto-repair">🔲 未启用</span>
        </div>
        <input type="checkbox" id="ops-auto-repair" class="accent-rose-500">
      </label>
      <label class="flex items-center justify-between p-3 rounded-xl bg-black/20 cursor-pointer hover:bg-white/5 transition">
        <div>
          <span class="text-white text-sm">📈 自动扩缩容</span>
          <span class="text-emerald-400 text-[10px] ml-2 ops-active-badge" data-key="ops-auto-scale" style="display:none">✅ 已生效</span>
          <span class="text-gray-500 text-[10px] ml-2 ops-inactive-badge" data-key="ops-auto-scale">🔲 未启用</span>
        </div>
        <input type="checkbox" id="ops-auto-scale" class="accent-rose-500">
      </label>
      <label class="flex items-center justify-between p-3 rounded-xl bg-black/20 cursor-pointer hover:bg-white/5 transition">
        <div>
          <span class="text-white text-sm">🛡️ 面板守护</span>
          <span class="text-emerald-400 text-[10px] ml-2">✅ 已生效</span>
          <span class="text-gray-600 text-xs ml-1">PM2 已实现</span>
        </div>
        <input type="checkbox" id="ops-panel-guard" class="accent-rose-500">
      </label>
    </div>

    <button onclick="saveOpsConfig()" class="mt-4 w-full bg-rose-600 hover:bg-rose-500 text-white py-2 rounded-xl text-sm transition">保存配置</button>
  </div>
</div>

<script nonce="<%= nonce %>">
(function() {
  const OPS_KEYS = [
    { id: 'ops-target-nodes', key: 'ops_target_nodes', type: 'int' },
    { id: 'ops-patrol-interval', key: 'ops_patrol_interval', type: 'int' },
    { id: 'ops-max-daily-swaps', key: 'ops_max_daily_swaps', type: 'int' },
    { id: 'ops-max-daily-creates', key: 'ops_max_daily_creates', type: 'int' },
    { id: 'ops-auto-swap-ip', key: 'ops_auto_swap_ip', type: 'bool' },
    { id: 'ops-auto-repair', key: 'ops_auto_repair', type: 'bool' },
    { id: 'ops-auto-scale', key: 'ops_auto_scale', type: 'bool' },
    { id: 'ops-panel-guard', key: 'ops_panel_guard', type: 'bool' },
  ];

  const EVENT_ICONS = {
    node_blocked: { icon: '🚫', color: 'text-red-400' },
    auto_swap_ip: { icon: '🔄', color: 'text-orange-400' },
    swap_ip: { icon: '🔄', color: 'text-orange-400' },
    ip_rotated: { icon: '🔄', color: 'text-orange-400' },
    node_recovered: { icon: '✅', color: 'text-emerald-400' },
    deploy: { icon: '🚀', color: 'text-blue-400' },
    health_check: { icon: '💓', color: 'text-cyan-400' },
    auto_repair: { icon: '🔧', color: 'text-yellow-400' },
    ops_config: { icon: '⚙️', color: 'text-gray-400' },
    node_create: { icon: '➕', color: 'text-green-400' },
    node_delete: { icon: '➖', color: 'text-red-400' },
    patrol: { icon: '🐱', color: 'text-purple-400' },
    instance_create: { icon: '☁️', color: 'text-blue-400' },
    instance_terminate: { icon: '💀', color: 'text-red-400' },
    diagnosis_pending: { icon: '🩺', color: 'text-yellow-400' },
    diagnosis_resolved: { icon: '💊', color: 'text-emerald-400' },
    diagnosis_failed: { icon: '❌', color: 'text-red-400' },
    auto_swap_ip_start: { icon: '🔄', color: 'text-orange-400' },
    auto_swap_ip_ok: { icon: '✅', color: 'text-emerald-400' },
    auto_swap_ip_fail: { icon: '❌', color: 'text-red-400' },
    node_xray_down: { icon: '🔴', color: 'text-red-400' },
    traffic_exceed: { icon: '⚠️', color: 'text-yellow-400' },
  };

  const STATUS_COLORS = { pending: 'text-yellow-400 border-yellow-500/20', resolved: 'text-emerald-400 border-emerald-500/20', failed: 'text-red-400 border-red-500/20' };

  function updateOpsBadges() {
    document.querySelectorAll('.ops-active-badge').forEach(el => {
      const cb = document.getElementById(el.dataset.key);
      el.style.display = cb && cb.checked ? '' : 'none';
    });
    document.querySelectorAll('.ops-inactive-badge').forEach(el => {
      const cb = document.getElementById(el.dataset.key);
      el.style.display = cb && cb.checked ? 'none' : '';
    });
  }

  // checkbox 变化时实时更新标记
  ['ops-auto-repair', 'ops-auto-scale'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', updateOpsBadges);
  });

  window.loadOpsDashboard = async function() {
    try {
      const [dashRes, eventsRes, cfgRes] = await Promise.all([
        fetch('/admin/api/ops-dashboard'), fetch('/admin/api/ops-events'),
        fetch('/admin/api/ops-config')
      ]);
      const dash = await dashRes.json();
      const events = await eventsRes.json();
      const cfg = await cfgRes.json();

      // 健康卡片
      document.getElementById('ops-total').textContent = dash.total;
      document.getElementById('ops-online').textContent = dash.online;
      document.getElementById('ops-offline').textContent = dash.offline;
      document.getElementById('ops-blocked').textContent = dash.blocked;

      // 巡检状态
      const lp = dash.lastPatrol;
      document.getElementById('ops-last-patrol').textContent = dash.lastPatrolDisplay || '从未';
      document.getElementById('ops-patrol-count').textContent = dash.todayStats?.patrols || 0;
      document.getElementById('ops-swap-count').textContent = dash.todayStats?.swaps || 0;
      document.getElementById('ops-fix-count').textContent = dash.todayStats?.fixes || 0;

      // 事件时间线
      const tl = document.getElementById('ops-timeline');
      if (!events.length) {
        tl.innerHTML = '<p class="text-gray-600 text-xs text-center py-4">暂无运维事件</p>';
      } else {
        tl.innerHTML = events.map(e => {
          const ei = EVENT_ICONS[e.action] || { icon: '📋', color: 'text-gray-400' };
          const time = e.created_at_display || '';
          return `<div class="flex items-start gap-3 p-2 rounded-lg bg-black/20 hover:bg-white/5 transition">
            <span class="text-lg flex-shrink-0">${ei.icon}</span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="${ei.color} text-xs font-medium">${escapeHtml(e.action)}</span>
                <span class="text-gray-600 text-[10px]">${escapeHtml(time)}</span>
              </div>
              <p class="text-gray-500 text-[11px] truncate mt-0.5">${escapeHtml(e.detail || '')}</p>
            </div>
          </div>`;
        }).join('');
      }

      // 配置
      for (const k of OPS_KEYS) {
        const el = document.getElementById(k.id);
        if (!el) continue;
        const val = cfg[k.key];
        if (k.type === 'bool') el.checked = val === 'true';
        else if (val) el.value = val;
      }

      // 更新动态生效标记
      updateOpsBadges();
    } catch (e) { console.error('ops dashboard error', e); }
  };

  window.saveOpsConfig = async function() {
    const data = {};
    for (const k of OPS_KEYS) {
      const el = document.getElementById(k.id);
      if (!el) continue;
      data[k.key] = k.type === 'bool' ? String(el.checked) : el.value;
    }
    try {
      const res = await fetch('/admin/api/ops-config', {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window._csrf || '' },
        body: JSON.stringify(data)
      });
      if (res.ok) showToast('✅ 运维配置已保存');
      else showToast('❌ 保存失败');
    } catch (e) { showToast('❌ ' + e.message); }
  };

  window.loadOpsConfig = window.loadOpsDashboard;
})();
if (location.hash === '#ops') setTimeout(loadOpsDashboard, 100);
</script>
